{
    "version": 6,
    "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Set OPENEYE_ROOT in the environment, or override it in a local CMakeUserPresets.json.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OPENEYE_USE_SHARED": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Set OPENEYE_ROOT in the environment, or override it in a local CMakeUserPresets.json.",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OPENEYE_USE_SHARED": "ON"
            }
        },
        {
            "name": "tsan",
            "displayName": "Thread Sanitizer",
            "description": "Set OPENEYE_ROOT in the environment, or override it in a local CMakeUserPresets.json.",
            "binaryDir": "${sourceDir}/build-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST",
                "OECLUSTER_BUILD_PYTHON": "OFF",
                "OECLUSTER_BUILD_TOOLS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {"name": "default", "configurePreset": "default"},
        {"name": "debug", "configurePreset": "debug"},
        {"name": "tsan", "configurePreset": "tsan", "targets": ["oecluster_tests"]}
    ]
}
